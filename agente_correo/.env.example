# Copia este archivo a .env y edítalo. NO versionar .env.
# systemd lee este mismo archivo con EnvironmentFile=. Sin `export`, sin
# expansión de $HOME: usa rutas absolutas.

# --- Identidad ---------------------------------------------------------
# Cuenta del agente (la que envía y recibe).
GMAIL_USER=caballerotaitus7@gmail.com
# Única dirección autorizada a dar órdenes. Comparación exacta e
# insensible a mayúsculas contra la dirección parseada del header From.
# CAMBIA este valor por tu correo personal real.
AUTORIZADO_FROM=tu-correo-personal@gmail.com
# Opcional. Lista separada por comas a la que el CLI de envío puede escribir.
# Si se omite o queda vacía, solo se permite AUTORIZADO_FROM.
# DESTINATARIOS_PERMITIDOS=tu-correo-personal@gmail.com

# --- OAuth 2.0 ---------------------------------------------------------
GOOGLE_CLIENT_SECRET=/home/arturo/Documentos/HerramientasAgente/agente_correo/secrets/client_secret.json
GOOGLE_TOKEN=/home/arturo/Documentos/HerramientasAgente/agente_correo/secrets/token.json
OAUTH_PORT=8765

# --- Google Drive ------------------------------------------------------
# Opcional. Con scope drive.file, la app solo ve archivos que ella creó.
# Si el ID no es accesible, el agente crea/usará la carpeta AgenteCorreo.
DRIVE_FOLDER_ID=

# --- Rutas -------------------------------------------------------------
REPO_DIR=/home/arturo/Documentos/HerramientasAgente
PYTHON_BIN=/home/arturo/Documentos/HerramientasAgente/.venv/bin/python
DIR_DATOS=/home/arturo/Documentos/HerramientasAgente/agente_correo/data
DIR_SALIDA=/home/arturo/Documentos/HerramientasAgente/agente_correo/out
DIR_ENTRADA=/home/arturo/Documentos/HerramientasAgente/agente_correo/entrada

# --- Límites y tiempos -------------------------------------------------
# Polling cada 45-60 s; 50 s por defecto.
POLL_SEGUNDOS=50
MAX_TAREAS_HORA=6
# Adjuntar si el total es <= este valor; si no, subir a Drive.
MAX_ADJUNTOS_MB=20
MAX_SALIDA_BYTES=65536
TIMEOUT_TAREA=120
TIMEOUT_SELECTOR=15
MAX_CUERPO_CHARS=4000
MAX_RESUMEN_CHARS=6000
MAX_ARTEFACTOS=8
MAX_ARTEFACTO_MB=200

# --- Política de herramientas -----------------------------------------
# Lista blanca de nombres que el selector puede ejecutar. Debe existir en
# scripts/orquestador/selector_herramientas.py y en capacidades.json.
# auditoria_wifi requiere sudo y está fuera por defecto.
HERRAMIENTAS_PERMITIDAS=sistema,redes,datos
# 0 = nunca reconectar la red por correo; 1 = permitir reconexión.
PERMITIR_RECONEXION=0

# --- Varios ------------------------------------------------------------
GMAIL_ETIQUETA_BASE=AgenteCorreo
LOG_LEVEL=INFO
